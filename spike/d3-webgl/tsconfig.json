{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "baseUrl": ".",
    "paths": {
      "common/*": ["../../packages/oxtty/xterm/stubs/common/*", "../../packages/oxtty/xterm/vendor-xterm/src/common/*"],
      "browser/*": ["../../packages/oxtty/xterm/stubs/browser/*", "../../packages/oxtty/xterm/vendor-xterm/src/browser/*"],
      "vs/*": ["../../packages/oxtty/xterm/stubs/vs/*"],
      "@xterm/xterm": ["../../packages/oxtty/xterm/stubs/xterm/xterm.d.ts"]
    }
  },
  "include": ["src", "../../packages/oxtty/xterm/stubs", "../../packages/oxtty/xterm/vendor-xterm"]
}
