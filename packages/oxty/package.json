{
  "name": "oxty",
  "version": "0.0.1",
  "description": "Terminal emulator engine in Rust, compiled to WebAssembly. Feed it PTY bytes, render the rows that changed.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oxty.wasm": "./dist/oxty.wasm"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bash ../../scripts/build-wasm.sh",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "terminal",
    "xterm",
    "vt100",
    "wasm",
    "rust",
    "emulator"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openwong2kim/oxty.git",
    "directory": "packages/oxty"
  },
  "engines": {
    "node": ">=18"
  }
}
