{
  "name": "oxtty",
  "version": "0.0.1",
  "description": "Terminal emulator engine in Rust, compiled to WebAssembly. Feed it PTY bytes, render the rows that changed.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oxtty.wasm": "./dist/oxtty.wasm"
  },
  "files": [
    "dist",
    "LICENSE-APACHE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bash ../../scripts/build-wasm.sh",
    "test": "node --test test/*.test.mjs",
    "test:xterm": "node --test xterm/test/*.test.mjs",
    "typecheck:xterm": "tsc --noEmit -p xterm"
  },
  "keywords": [
    "terminal",
    "xterm",
    "vt100",
    "wasm",
    "rust",
    "emulator"
  ],
  "license": "Apache-2.0 AND MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openwong2kim/oxtty.git",
    "directory": "packages/oxtty"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@xterm/addon-unicode11": "0.10.0-beta.301",
    "@xterm/addon-webgl": "0.20.0-beta.329",
    "@xterm/headless": "6.1.0-beta.303",
    "@xterm/xterm": "6.1.0-beta.336",
    "esbuild": "0.25.10",
    "playwright-core": "1.55.1",
    "typescript": "5.9.3"
  }
}
