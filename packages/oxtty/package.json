{
  "name": "oxtty",
  "version": "0.0.1",
  "description": "Terminal emulator engine in Rust, compiled to WebAssembly. Feed it PTY bytes, render the rows that changed.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./xterm": {
      "types": "./dist/xterm.d.ts",
      "default": "./dist/xterm.js"
    },
    "./oxtty.wasm": "./dist/oxtty.wasm",
    "./xterm_web_bg.wasm": "./dist/xterm_web_bg.wasm"
  },
  "files": [
    "dist",
    "LICENSE-APACHE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bash ../../scripts/build-wasm.sh && bash ../../scripts/build-web.sh",
    "test": "node --test test/*.test.mjs",
    "test:web": "node --test test/web/*.test.mjs"
  },
  "keywords": [
    "terminal",
    "xterm",
    "vt100",
    "wasm",
    "rust",
    "emulator"
  ],
  "license": "Apache-2.0 AND MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openwong2kim/oxtty.git",
    "directory": "packages/oxtty"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@xterm/addon-unicode11": "0.10.0-beta.301",
    "@xterm/addon-webgl": "0.20.0-beta.329",
    "@xterm/headless": "6.1.0-beta.303",
    "@xterm/xterm": "6.1.0-beta.336",
    "playwright-core": "1.55.1"
  }
}
